/* ==========================================================================
   Estilos Textual (TCSS) - Sistema de Empréstimo de Ferramentas
   Tema: Terminal Moderno Escuro com paleta agradável e alto contraste
   ========================================================================== */

Screen {
    background: #181825;
    color: #cdd6f4;
}

Header {
    background: #11111b;
    color: #89b4fa;
    dock: top;
    height: 3;
    content-align: center middle;
    text-style: bold;
    border-bottom: solid #313244;
}

Footer {
    background: #11111b;
    color: #a6adc8;
    dock: bottom;
}

/* ==========================================================================
   TELA PRINCIPAL (MainMenuScreen)
   ========================================================================== */

#main-menu-container {
    width: 80;
    height: auto;
    max-height: 90%;
    margin: 1 2;
    align: center middle;
    border: round #45475a;
    background: #1e1e2e;
    padding: 1 3;
}

#main-title {
    text-align: center;
    text-style: bold;
    color: #89b4fa;
    margin-bottom: 0;
}

#main-subtitle {
    text-align: center;
    color: #a6adc8;
    margin-bottom: 1;
}

#session-status-card {
    height: auto;
    padding: 1 2;
    margin: 1 0;
    border: solid #45475a;
    background: #252538;
}

.status-logged-in {
    color: #a6e3a1;
    text-style: bold;
}

.status-visitor {
    color: #f9e2af;
}

#menu-buttons-box {
    margin: 1 0;
    height: auto;
    align: center middle;
}

.menu-btn {
    width: 100%;
    margin: 1 0;
    text-align: left;
    height: 3;
}

/* ==========================================================================
   CATÁLOGO E LISTAGEM DE FERRAMENTAS (ToolListScreen & MyToolsScreen)
   ========================================================================== */

.screen-container {
    padding: 1 2;
    height: 100%;
}

.screen-header-title {
    color: #89b4fa;
    text-style: bold;
    text-align: left;
    margin-bottom: 0;
}

.screen-header-desc {
    color: #a6adc8;
    margin-bottom: 1;
}

#search-bar-container {
    height: 3;
    margin-bottom: 1;
}

#tools-table {
    height: 1fr;
    border: solid #45475a;
    background: #1e1e2e;
}

#details-panel {
    height: 10;
    margin-top: 1;
    padding: 1 2;
    border: round #585b70;
    background: #24253a;
}

.details-title {
    color: #cba6f7;
    text-style: bold;
    margin-bottom: 1;
}

.action-bar {
    height: 4;
    dock: bottom;
    padding: 1 0;
    align: right middle;
    background: #181825;
}

.action-bar Button {
    margin-left: 2;
}

/* ==========================================================================
   FORMULÁRIOS (AuthScreen, AddToolScreen, EditToolModal)
   ========================================================================== */

.form-container {
    width: 75;
    height: auto;
    max-height: 95%;
    margin: 1 2;
    align: center middle;
    border: round #89b4fa;
    background: #1e1e2e;
    padding: 1 3;
}

.form-label {
    color: #89b4fa;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

.form-input {
    margin-bottom: 1;
    border: tall #45475a;
}

.form-input:focus {
    border: tall #89b4fa;
}

.form-buttons {
    margin-top: 1;
    height: 3;
    align: right middle;
}

.form-buttons Button {
    margin-left: 2;
}

/* ==========================================================================
   TELA DE PERFIL (ProfileScreen)
   ========================================================================== */

#profile-card {
    width: 70;
    height: auto;
    margin: 1 2;
    align: center middle;
    border: round #b4befe;
    background: #1e1e2e;
    padding: 2 3;
}

.stats-grid {
    layout: grid;
    grid-size: 3;
    grid-gutter: 1;
    margin: 1 0;
    height: 7;
}

.stat-box {
    border: solid #45475a;
    background: #252538;
    padding: 1;
    text-align: center;
    align: center middle;
}

.stat-number {
    text-style: bold;
    color: #89b4fa;
    text-align: center;
}

.stat-label {
    color: #a6adc8;
    text-align: center;
}

/* ==========================================================================
   MODAIS (ConfirmModal, BorrowModal, DetailModal)
   ========================================================================== */

ModalScreen {
    align: center middle;
    background: rgba(17, 17, 27, 0.85);
}

.modal-dialog {
    width: 65;
    height: auto;
    border: thick #89b4fa;
    background: #1e1e2e;
    padding: 1 2;
}

.modal-title {
    text-align: center;
    color: #89b4fa;
    text-style: bold;
    margin-bottom: 1;
}

.modal-body {
    margin: 1 0;
    color: #cdd6f4;
}

.modal-phone-box {
    background: #2a2b3d;
    border: round #a6e3a1;
    padding: 1 2;
    margin: 1 0;
    text-align: center;
    color: #a6e3a1;
    text-style: bold;
}

.modal-buttons {
    margin-top: 1;
    align: right middle;
    height: 3;
}

.modal-buttons Button {
    margin-left: 2;
}

/* ==========================================================================
   UTILITÁRIOS E CORES DE STATUS
   ========================================================================== */

.badge-disponivel {
    color: #a6e3a1;
}

.badge-emprestado {
    color: #fab387;
}

.text-muted {
    color: #6c7086;
}

.text-error {
    color: #f38ba8;
    margin: 1 0;
}
